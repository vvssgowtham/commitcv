  "cards": [
    { "dot": "cyan", "title": "Repo RAG — indexing", "items": ["Tarball parsed in memory: facts (deps, infra) read exactly from manifests; README/docs/code split into line-numbered chunks", "Forks index only their own commits' changed lines, never the upstream author's code", "Unchanged chunks keep their embedding (content-hash reuse) — a re-sync only pays for what actually changed", "A daily cron (not shown) finishes any repo nobody kept the Projects page open for"] },
    { "dot": "emerald", "title": "Repo RAG — retrieval", "items": ["Hybrid search: cosine similarity (pgvector HNSW) + Postgres full-text, merged by reciprocal rank fusion", "Job analysis lists every repo's exact tech/facts (no search) — generation searches code against the job's extracted requirements", "Grounding rejects a code-cited bullet with any name or number not present in the cited excerpt"] },
    { "dot": "amber", "title": "Shared free-tier guardrails", "items": ["ai_usage_daily (Postgres) tracks Groq tokens and Workers AI Neurons per day, shared by every user", "Over budget ⇒ CapacityError: indexing pauses, user actions show a clear retry-later message", "Over Groq's per-request estimate ⇒ one retry with less repo evidence, instead of failing outright"] }
  ]
